{
  "trash_id": "local-ru-without-original",
  "name": "RU without Original",
  "includeCustomFormatWhenRenaming": false,
  "specifications": [
    {
      "name": "Cyrillic title or RU voice-over tags",
      "implementation": "ReleaseTitleSpecification",
      "negate": false,
      "required": true,
      "fields": {
        "value": "[А-Яа-яЁё]|\\b(MVO|DVO|AVO|Dub)\\b"
      }
    },
    {
      "name": "Original track not mentioned",
      "implementation": "ReleaseTitleSpecification",
      "negate": true,
      "required": true,
      "fields": {
        "value": "\\b(Original|ENG)\\b|Оригинал"
      }
    }
  ]
}
