{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Select your Loki data source",
      "type": "datasource",
      "pluginId": "loki"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "logs",
      "name": "Logs",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "title": "Avg Throughput",
      "type": "stat",
      "id": 1,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "color": { "mode": "background" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(rate({job=~\"$job\", host=~\"$host\", unit=~\"$unit\"}[$__range])) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Total Logs",
      "type": "stat",
      "id": 2,
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({job=~\"$job\", host=~\"$host\", unit=~\"$unit\"}[$__range])) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Info",
      "type": "stat",
      "id": 3,
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({job=~\"$job\", host=~\"$host\", unit=~\"$unit\", level=\"info\"}[$__range])) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Warnings",
      "type": "stat",
      "id": 4,
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({job=~\"$job\", host=~\"$host\", unit=~\"$unit\", level=\"warning\"}[$__range])) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Errors / Critical",
      "type": "stat",
      "id": 5,
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({job=~\"$job\", host=~\"$host\", unit=~\"$unit\", level=~\"error|critical\"}[$__range])) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Last Info Logs",
      "type": "logs",
      "id": 6,
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 4 },
      "options": { "showTime": true, "sortOrder": "Descending" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{job=~\"$job\", host=~\"$host\", unit=~\"$unit\", level=\"info\"}",
          "maxLines": 5,
          "refId": "A"
        }
      ]
    },
    {
      "title": "Last Warnings",
      "type": "logs",
      "id": 7,
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 10 },
      "options": { "showTime": true, "sortOrder": "Descending" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{job=~\"$job\", host=~\"$host\", unit=~\"$unit\", level=\"warning\"}",
          "maxLines": 5,
          "refId": "A"
        }
      ]
    },
    {
      "title": "Last Errors / Critical",
      "type": "logs",
      "id": 8,
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "options": { "showTime": true, "sortOrder": "Descending" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{job=~\"$job\", host=~\"$host\", unit=~\"$unit\", level=~\"error|critical\"}",
          "maxLines": 5,
          "refId": "A"
        }
      ]
    },
    {
      "title": "Activity by Unit",
      "type": "timeseries",
      "id": 9,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 25 },
          "links": [
            {
              "title": "Filter to ${__series.name}",
              "url": "${__dashboard.url}?${__url_time_range}&var-unit=${__series.name}",
              "targetBlank": false
            }
          ]
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum by (unit) (count_over_time({job=~\"$job\", host=~\"$host\", unit=~\"$unit\"}[$__interval]))",
          "legendFormat": "{{unit}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Activity by Level",
      "type": "timeseries",
      "id": 11,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 30 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 40 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [
              {
                "id": "color",
                "value": { "fixedColor": "red", "mode": "fixed" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "critical" },
            "properties": [
              {
                "id": "color",
                "value": { "fixedColor": "dark-red", "mode": "fixed" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "warning" },
            "properties": [
              {
                "id": "color",
                "value": { "fixedColor": "orange", "mode": "fixed" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "info" },
            "properties": [
              {
                "id": "color",
                "value": { "fixedColor": "blue", "mode": "fixed" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "debug" },
            "properties": [
              {
                "id": "color",
                "value": { "fixedColor": "gray", "mode": "fixed" }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum by (level) (count_over_time({job=~\"$job\", host=~\"$host\", unit=~\"$unit\", level=~\".+\"}[$__interval]))",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Raw Log Stream",
      "type": "logs",
      "id": 10,
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 38 },
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogLines": true,
        "enableLogDetails": true,
        "showLabels": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{job=~\"$job\", host=~\"$host\", unit=~\"$unit\"}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["loki", "logs", "systemd"],
  "templating": {
    "list": [
      {
        "name": "DS_LOKI",
        "type": "datasource",
        "query": "loki",
        "label": "Loki"
      },
      {
        "name": "host",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "definition": "label_values(host)",
        "query": "label_values(host)",
        "multi": true,
        "includeAll": true,
        "label": "Host",
        "refresh": 1
      },
      {
        "name": "job",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "definition": "label_values({host=~\"$host\"}, job)",
        "query": "label_values({host=~\"$host\"}, job)",
        "multi": true,
        "includeAll": true,
        "label": "Job",
        "refresh": 1
      },
      {
        "name": "unit",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "definition": "label_values({job=~\"$job\", host=~\"$host\"}, unit)",
        "query": "label_values({job=~\"$job\", host=~\"$host\"}, unit)",
        "multi": true,
        "includeAll": true,
        "label": "Unit",
        "refresh": 2
      },
      {
        "name": "level",
        "type": "custom",
        "options": [
          { "text": "All", "value": ".+", "selected": true },
          { "text": "critical", "value": "critical" },
          { "text": "error", "value": "error" },
          { "text": "warning", "value": "warning" },
          { "text": "notice", "value": "notice" },
          { "text": "info", "value": "info" },
          { "text": "debug", "value": "debug" }
        ],
        "multi": false,
        "includeAll": false,
        "label": "Level"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "System Logs (Loki)",
  "uid": "homeserver-loki-logs",
  "description": "Systemd journal logs via Alloy + Loki. Filtered by host, job, unit, level."
}
