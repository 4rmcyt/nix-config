# Enable nix-direnv integration for faster loading
# This caches the dev environment and makes reloading much faster
if ! has nix_direnv_version || ! nix_direnv_version 3.0.4; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.4/direnvrc" "sha256-DzlYZ33mWF/Gs8DDeyjr8mnVmQGx7ASYqA5WlxwvBG4="
fi

# Load the flake's devShell with nix-direnv caching
use flake . --impure

# Watch additional files for changes (auto-reload on modification)
watch_file flake.nix
watch_file flake.lock
watch_file devshell.nix
watch_file treefmt.nix

# Set custom environment variables
export NIX_CONFIG_DIR="$PWD"

# Automatically set up git hooks or other project-specific setup
# Example: ensure secrets directory exists
# [[ -d secrets ]] || mkdir -p secrets

# Load additional environment variables from a local file (git-ignored)
# This is useful for machine-specific or secret variables
# if [[ -f .envrc.local ]]; then
#   source_env .envrc.local
# fi

# Add project binaries to PATH
# PATH_add result/bin

# Set NIX_PATH for backward compatibility if needed
# export NIX_PATH="nixpkgs=$HOME/.nix-defexpr/channels/nixpkgs:$NIX_PATH"
